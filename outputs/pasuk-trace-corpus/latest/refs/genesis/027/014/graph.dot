  "ק:3:1" -> "ק:3:2" [xlabel="sub", style="dashed", color="#6A8E4E"];
  "ש:8:1" -> "ש:8:2" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:8:2" -> "ש:8:3" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:8:3" -> "ש:8:1" [xlabel="loop", style="dotted", color="#8FB07A"];
  legend -> "Ω" [style=invis];
}
