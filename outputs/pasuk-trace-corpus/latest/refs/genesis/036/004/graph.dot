  "ש:3:1" -> "ש:3:2" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:3:2" -> "ש:3:3" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:3:3" -> "ש:3:1" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:7:4" -> "ש:7:5" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:7:5" -> "ש:7:6" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:7:6" -> "ש:7:4" [xlabel="loop", style="dotted", color="#8FB07A"];
  legend -> "Ω" [style=invis];
}
