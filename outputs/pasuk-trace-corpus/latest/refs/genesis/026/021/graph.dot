  "ה:8:1" -> "ה:8:2" [xlabel="sub", style="dashed", color="#6A8E4E"];
  "ק:10:1" -> "ק:10:2" [xlabel="sub", style="dashed", color="#6A8E4E"];
  "ש:12:4" -> "ש:12:5" [xlabel="loop", style="dotted", color="#8FB07A"];
