  "ה:4:3" -> "ה:4:4" [xlabel="sub", style="dashed", color="#6A8E4E"];
  "ה:9:5" -> "ה:9:6" [xlabel="sub", style="dashed", color="#6A8E4E"];
  "ק:1:1" -> "ק:1:2" [xlabel="sub", style="dashed", color="#6A8E4E"];
  legend -> "Ω" [style=invis];
}
