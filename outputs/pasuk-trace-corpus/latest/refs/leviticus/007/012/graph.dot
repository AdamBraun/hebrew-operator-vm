  "ק:13:7" -> "ק:13:8" [xlabel="sub", style="dashed", color="#6A8E4E"];
  "ק:2:3" -> "ק:2:4" [xlabel="sub", style="dashed", color="#6A8E4E"];
  legend -> "Ω" [style=invis];
}
