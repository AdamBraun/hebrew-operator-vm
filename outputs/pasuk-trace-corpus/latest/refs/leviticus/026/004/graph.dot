  "ש:11:5" -> "ש:11:6" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:11:6" -> "ש:11:4" [xlabel="loop", style="dotted", color="#8FB07A"];
  legend -> "Ω" [style=invis];
}
