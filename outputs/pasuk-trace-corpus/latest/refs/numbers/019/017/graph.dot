  "ש:6:2" -> "ש:6:3" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:6:3" -> "ש:6:1" [xlabel="loop", style="dotted", color="#8FB07A"];
  legend -> "Ω" [style=invis];
}
