  "ת:6:15" -> "ש:6:4" [xlabel="sub", style="dashed", color="#6A8E4E"];
  "ת:6:15" -> "ש:6:5" [xlabel="sub", style="dashed", color="#6A8E4E"];
  "ת:6:15" -> "ש:6:6" [xlabel="sub", style="dashed", color="#6A8E4E"];
  legend -> "Ω" [style=invis];
}
