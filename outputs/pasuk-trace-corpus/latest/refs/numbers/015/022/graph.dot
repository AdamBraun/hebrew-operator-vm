  "ש:5:5" -> "ש:5:6" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:5:6" -> "ש:5:4" [xlabel="loop", style="dotted", color="#8FB07A"];
  legend -> "Ω" [style=invis];
}
