  "ה:4:5" -> "ה:4:6" [xlabel="sub", style="dashed", color="#6A8E4E"];
  "ה:8:7" -> "ה:8:8" [xlabel="sub", style="dashed", color="#6A8E4E"];
  legend -> "Ω" [style=invis];
}
