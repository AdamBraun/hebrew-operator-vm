  "ה:11:3" -> "ה:11:4" [xlabel="sub", style="dashed", color="#6A8E4E"];
  "ה:2:1" -> "ה:2:2" [xlabel="sub", style="dashed", color="#6A8E4E"];
  legend -> "Ω" [style=invis];
}
