  "ק:11:1" -> "ק:11:2" [xlabel="sub", style="dashed", color="#6A8E4E"];
  "ש:5:1" -> "ש:5:2" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:5:2" -> "ש:5:3" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:5:3" -> "ש:5:1" [xlabel="loop", style="dotted", color="#8FB07A"];
  legend -> "Ω" [style=invis];
}
