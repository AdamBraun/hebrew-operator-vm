  "ע:21:1" -> "ש:21:2" [xlabel="sub", style="dashed", color="#6A8E4E"];
  "ע:21:1" -> "ש:21:3" [xlabel="sub", style="dashed", color="#6A8E4E"];
  "ש:21:1" -> "ש:21:2" [xlabel="loop", style="dotted", color="#8FB07A"];
