  "ש:4:1" -> "ש:4:2" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:4:2" -> "ש:4:3" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:4:3" -> "ש:4:1" [xlabel="loop", style="dotted", color="#8FB07A"];
  legend -> "Ω" [style=invis];
}
