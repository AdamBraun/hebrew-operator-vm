  "ש:11:1" -> "ש:11:2" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:11:2" -> "ש:11:3" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:11:3" -> "ש:11:1" [xlabel="loop", style="dotted", color="#8FB07A"];
  legend -> "Ω" [style=invis];
}
