  "ש:1:2" -> "ש:1:3" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:1:3" -> "ש:1:1" [xlabel="loop", style="dotted", color="#8FB07A"];
  legend -> "Ω" [style=invis];
}
