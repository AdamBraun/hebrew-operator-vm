  "ש:2:1" -> "ש:2:2" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:2:2" -> "ש:2:3" [xlabel="loop", style="dotted", color="#8FB07A"];
  "ש:2:3" -> "ש:2:1" [xlabel="loop", style="dotted", color="#8FB07A"];
  legend -> "Ω" [style=invis];
}
