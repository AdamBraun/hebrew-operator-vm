  "ה:9:5" -> "ה:9:6" [xlabel="sub", style="dashed", color="#6A8E4E"];
  "ק:6:1" -> "ק:6:2" [xlabel="sub", style="dashed", color="#6A8E4E"];
  legend -> "Ω" [style=invis];
}
